{
  "entities": {
    "LexUser": {
      "title": "LexUser",
      "description": "Administrator profile record in LexMedia Ctrl Room",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "pendingEmail": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "enum": ["admin", "staff"] }
      },
      "required": ["uid", "email", "name", "role"]
    },
    "BrandingSetting": {
      "title": "BrandingSetting",
      "description": "Workspace and invoice branding settings",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 120 },
        "logoUrl": { "type": "string", "maxLength": 2048 },
        "primaryColor": { "type": "string", "maxLength": 16 },
        "accentColor": { "type": "string", "maxLength": 16 },
        "buttonColor": { "type": "string", "maxLength": 16 }
      }
    },
    "ClientRecord": {
      "title": "ClientRecord",
      "description": "Client directory entry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 254 },
        "phone": { "type": "string", "maxLength": 40 }
      },
      "required": ["name"]
    },
    "ProjectRecord": {
      "title": "ProjectRecord",
      "description": "Client project record",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 240 },
        "clientId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["title"]
    },
    "InvoiceRecord": {
      "title": "InvoiceRecord",
      "description": "Invoice document record",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "clientId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["invoiceNumber"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "LexUser",
      "description": "Administrator user profiles"
    },
    "/settings/{docId}": {
      "schema": "BrandingSetting",
      "description": "Workspace branding and business settings"
    },
    "/clients/{docId}": {
      "schema": "ClientRecord",
      "description": "Client records"
    },
    "/projects/{docId}": {
      "schema": "ProjectRecord",
      "description": "Project records"
    },
    "/invoices/{docId}": {
      "schema": "InvoiceRecord",
      "description": "Invoice records"
    }
  }
}
