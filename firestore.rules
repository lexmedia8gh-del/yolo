rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Default: deny everything ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Admin authorization ─────────────────────────────────────────────────
    // Verifies Firebase Custom Claim, verified LexMedia administrator emails,
    // or UID-bound admin role on the user's own profile document.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'natlexmediah@gmail.com',
            'lexmedia8gh@gmail.com',
            'lexmediaapp@gmail.com'
          ]
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // ─── User profiles ───────────────────────────────────────────────────────
    // Authenticated user can read their own profile (or admin can read);
    // client-side writes are restricted to the authenticated admin's own uid
    // and cannot alter role privileges.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.auth.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.uid.size() <= 128
        && request.resource.data.uid == uid
        && request.resource.data.role == 'admin'
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120));
      allow update: if isAdmin()
        && request.auth.uid == uid
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128 && request.resource.data.uid == uid))
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120));
      allow delete: if false;
    }

    // ─── Core Business Data (Admin Only) ─────────────────────────────────────
    // IMPORTANT: These were previously open to ALL authenticated users.
    // Now only the token with admin:true custom claim can access them.
    match /clients/{docId}        { allow read, write: if isAdmin(); }
    match /services/{docId}       { allow read, write: if isAdmin(); }
    match /projects/{docId}       { allow read, write: if isAdmin(); }
    match /packages/{docId}       { allow read, write: if isAdmin(); }
    match /invoices/{docId}       { allow read, write: if isAdmin(); }
    match /invoiceItems/{docId}   { allow read, write: if isAdmin(); }
    match /payments/{docId}       { allow read, write: if isAdmin(); }
    match /activityLogs/{docId}   { allow read, write: if isAdmin(); }
    match /settings/{docId}       { allow read, write: if isAdmin(); }
    match /brands/{docId}         { allow read, write: if isAdmin(); }
    match /whatsappMessages/{docId} { allow read, write: if isAdmin(); }
    match /notifications/{docId}  { allow read, write: if isAdmin(); }
    match /reminders/{docId}      { allow read, write: if isAdmin(); }
    match /tasks/{docId}          { allow read, write: if isAdmin(); }
    match /quickJobs/{docId}      { allow read, write: if isAdmin(); }
    match /addOns/{docId}         { allow read, write: if isAdmin(); }
    match /files/{docId}          { allow read, write: if isAdmin(); }

    // ─── Delivery System ─────────────────────────────────────────────────────
    // Delivery metadata is read by the server-side API routes using the Admin SDK
    // (which bypasses rules). The client delivery portal reads via server API only.
    // Admin reads/writes are protected by the admin claim.
    // Public reads here are required for the client portal token validation flow.
    match /deliveries/{docId} {
      allow read: if true;              // Token-gated server-side; public read needed for client portal
      allow write: if isAdmin();        // Only admin can create/update/delete deliveries
    }

    match /deliveryFiles/{docId} {
      allow read: if true;              // Client portal reads file metadata via token
      allow write: if isAdmin();        // Only admin can upload/delete delivery files
    }

    // ─── Client Payment Links (Public Access for Paystack flow) ──────────────
    // Clients receive a link with a unique token; the link data is public.
    // Only admin can create or delete payment links.
    match /clientLinks/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Client Previews (View-Only Proofing Portal) ─────────────────────────
    // Previews are token-gated server-side.
    // Admin has full read/write management.
    match /clientPreviews/{previewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /previewLogs/{logId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
